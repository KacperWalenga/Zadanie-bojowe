<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="GameViewport" src="project://database/Assets/_ZB/UI/Components/Viewport/GameViewport.uxml" />
    <ui:Template name="HealthBar" src="project://database/Assets/_ZB/UI/Components/HealthBar/HealthBar.uxml" />
    <ui:Template name="StatsPanel" src="project://database/Assets/_ZB/UI/Components/Stats/StatsPanel.uxml" />
    <ui:Template name="BookPanel" src="project://database/Assets/_ZB/UI/Components/Book/BookPanel.uxml" />
    <ui:Template name="MinimapPanel" src="project://database/Assets/_ZB/UI/Components/Minimap/MinimapPanel.uxml" />
    <ui:Template name="GameOver" src="project://database/Assets/_ZB/UI/Components/GameOver/GameOver.uxml" />
    <Style src="project://database/Assets/_ZB/UI/StoneTheme.uss" />
    <Style src="project://database/Assets/_ZB/UI/Components/Viewport/GameViewport.uss" />
    <Style src="project://database/Assets/_ZB/UI/Components/HealthBar/HealthBar.uss" />
    <Style src="project://database/Assets/_ZB/UI/Components/Stats/StatsPanel.uss" />
    <Style src="project://database/Assets/_ZB/UI/Components/Book/BookPanel.uss" />
    <Style src="project://database/Assets/_ZB/UI/Components/Minimap/MinimapPanel.uss" />
    <Style src="project://database/Assets/_ZB/UI/Components/StoneButton.uss" />
    <Style src="project://database/Assets/_ZB/UI/HUD.uss" />
    <Style src="project://database/Assets/_ZB/UI/Components/GameOver/GameOver.uss" />

    <ui:VisualElement class="hud stone stone--surface">
        <ui:Instance template="GameViewport" name="viewport" class="hud__viewport" />

        <ui:VisualElement class="hud__sidebar">
            <ui:Instance template="HealthBar" name="health-bar" class="hud__health" />

            <ui:VisualElement class="hud__content">
                <ui:VisualElement class="hud__level stone stone--frame">
                    <ui:Label name="level-label" text="PIWNICA 1" class="hud__level-title stone__recess stone__text" />
                </ui:VisualElement>

                <ui:Instance template="StatsPanel" class="hud__stats" />

                <ui:Instance template="BookPanel" name="journal-panel" class="hud__panel" />
                <ui:Instance template="MinimapPanel" name="minimap-panel" class="hud__panel hud__panel--hidden" />

                <ui:VisualElement class="hud__tabs">
                    <ui:Button name="minimap-tab" text="MINIMAPA" class="hud__tab stone__text stone-button" />
                    <ui:Button name="journal-tab" text="DZIENNIK" class="hud__tab hud__tab--journal stone__text stone-button stone-button--selected" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:Instance template="GameOver" name="game-over" class="game-over-screen game-over--hidden" />
</ui:UXML>
