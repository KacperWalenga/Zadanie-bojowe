.hud {
    flex-grow: 1;
    flex-direction: row;
    padding: 26.5px;
}

.hud__viewport {
    flex-grow: 2;
    flex-basis: 0px;
    min-width: 0;
    margin-right: 26.5px;
}

#viewport .game-viewport {
    background-image: url("project://database/Assets/_ZB/Shaders/Pixelation/Pixelate%20Texture.renderTexture");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.hud__sidebar {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0;
}

.hud__level,
.hud__health {
    height: 66.5px;
    flex-shrink: 0;
    margin-bottom: 26.5px;
}

.hud__level-title {
    font-size: 42.5px;
    -unity-text-align: middle-center;
}

.hud__timers {
    flex-direction: row;
    height: 166.5px;
    flex-shrink: 0;
    margin-bottom: 26.5px;
}

.hud__timer {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0;
}

.hud__timer--level {
    margin-right: 26.5px;
}

.hud__book {
    margin-top: auto;
    flex-grow: 0;
    min-height: 0;
}
