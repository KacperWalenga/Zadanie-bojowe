.hud {
    flex-grow: 1;
    flex-direction: row;
    padding: 24px;
}

.hud__viewport {
    flex-grow: 2;
    flex-basis: 0;
    min-width: 0;
    margin-right: 24px;
}

.hud__sidebar {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
}

.hud__health {
    width: 50px;
    flex-shrink: 0;
    margin-right: 12px;
}

.hud__content {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}

.hud__level {
    flex-shrink: 0;
    margin-bottom: 12px;
}

.hud__level-title {
    font-size: 40px;
    -unity-text-align: middle-center;
    padding: 2px 8px;
}

.hud__stats {
    flex-shrink: 0;
    margin-bottom: 12px;
}

.hud__panel {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.hud__panel--hidden {
    display: none;
}

.hud__tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 12px;
}

.hud__tab {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: 17px;
}

.hud__tab--journal {
    margin-left: 12px;
}
