.game-viewport,
.game-viewport__image {
.game-viewport-container{
    position: relative;
}

.game-viewport {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
}

.game-viewport__image {
    background-image: url("project://database/Assets/_ZB/Shaders/Pixelation/Pixelate%20Texture.renderTexture");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
    
.combat-fields {
    position: absolute;
    font-size: 48px;
    bottom: 2%;
    color: white;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 2%;
}