.book {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.book__body {
    justify-content: center;
    align-items: center;
    padding: 10px;
}

.book__image {
    width: 100%;
    max-width: 500px;
    max-height: 100%;
    aspect-ratio: 1.384937;
    background-image: url("project://database/Assets/_ZB/UI/Textures/Book/Book.png");
    background-size: 100% 100%;
    background-repeat: no-repeat;
}

.book__page {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.book__navigation {
    position: absolute;
    right: 0;
    bottom: 16%;
    left: 0;
    height: 18%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 19%;
}

.book__button {
    height: 100%;
    aspect-ratio: 1.048951;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    -unity-background-image-tint-color: white;
    background-color: transparent;
    background-image: url("project://database/Assets/_ZB/UI/Textures/Book/button-left.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    transition-property: scale;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
}

.book__button--right {
    aspect-ratio: 1.019108;
    background-image: url("project://database/Assets/_ZB/UI/Textures/Book/button-right.png");
}

.book__button:hover {
    scale: 1.1 1.1;
}

.book__button:active {
    scale: 0.95 0.95;
}
