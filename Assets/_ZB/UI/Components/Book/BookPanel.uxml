<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="hud-widget stone-frame">
        <ui:VisualElement class="stone-recess">
            <ui:VisualElement class="book">
                <ui:VisualElement class="book__image">
                    <ui:Image name="page-image" class="book__page" source="project://database/Assets/_ZB/UI/Textures/Book/Pages/0.png" />
                    
                    <ui:VisualElement class="book__navigation">
                        <ui:Button name="book-btn-left" class="book__button" />
                        <ui:Button name="book-btn-right" class="book__button book__button--right" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
