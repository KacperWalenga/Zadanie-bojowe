.minimap,
.minimap__content {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.minimap__content {
    background-image: url("project://database/Assets/_ZB/Shaders/Minimap/Minimap%20Texture.renderTexture");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}