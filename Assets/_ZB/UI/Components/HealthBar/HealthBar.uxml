<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="health-bar stone stone--frame">
        <ui:VisualElement class="health-bar__body stone__recess">
            <ui:VisualElement class="health-bar__tube">
                <ui:VisualElement class="health-bar__fill" picking-mode="Ignore" />
                <ui:VisualElement class="health-bar__glass" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
