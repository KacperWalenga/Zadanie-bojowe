.health-bar {
    flex-grow: 1;
    min-height: 0;
}

.health-bar__body {
    padding: 8px 4px;
}

.health-bar__tube {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    border-radius: 4px;
    overflow: hidden;
}

.health-bar__fill,
.health-bar__glass {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.health-bar__fill {
    background-color: white;
    -unity-material: url("project://database/Assets/_ZB/UI/Textures/BeerMat.mat");
}

.health-bar__glass {
    background-image: url("project://database/Assets/_ZB/UI/Textures/HealthReflex.png");
    background-size: 100% 100%;
    background-repeat: no-repeat;
}
