.container {
    padding: 10px;
}

.title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 12px;
}

.dimensions {
    flex-direction: row;
}

.dimensions > IntegerField {
    flex-grow: 1;
    margin-right: 5px;
}

.info {
    margin-top: 5px;
    margin-bottom: 10px;
    color: #999999;
    font-size: 11px;
}

.footer {
    margin-top: 8px;
}
