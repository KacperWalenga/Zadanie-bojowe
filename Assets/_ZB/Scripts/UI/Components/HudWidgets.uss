.hud-widget {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.game-viewport {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
}

.timer-content {
    justify-content: space-between;
}

.timer-caption,
.timer-value {
    font-size: 35px;
    -unity-text-align: middle-center;
    padding: 10px;
}

.timer-caption {
    white-space: pre-wrap;
}

.timer-value {
    white-space: nowrap;
}

.health-content {
    padding: 10px;
}

.health-fill {
    flex-grow: 1;
    width: 100%;
    background-image: url("project://database/Assets/_ZB/Scripts/UI/Theme/Textures/Health.png");
    background-size: 100% 100%;
}

.health-highlight {
    flex-grow: 1;
    background-image: url("project://database/Assets/_ZB/Scripts/UI/Theme/Textures/HealthHighlight.png");
    background-size: 100% 100%;
}

.book-pages {
    flex-grow: 1;
    min-height: 0;
    background-image: url("project://database/Assets/_ZB/Scripts/UI/Theme/Textures/Book.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    padding: 8% 12%;
    display: flex;
    flex-direction: row;
}

.book-page {
    padding: 5px 0 30px 0px;
}

.book-text {
    width: 100%;
    -unity-text-align: middle-center;
}

.book-text {
    color: #30251b;
    white-space: normal;
}

.book-image {
    filter: grayscale(100%);
}
